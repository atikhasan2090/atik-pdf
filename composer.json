{
    "name": "atik/atik-pdf",
    "description": "Enterprise-grade hybrid Laravel PDF package with ultra-fast large-table PDF generation and full Bangla font support.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Atik",
            "email": "atik@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "mpdf/mpdf": "^8.2",
        "spatie/browsershot": "^5.3",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Atik\\Pdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atik\\Pdf\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atik\\Pdf\\AtikPdfServiceProvider"
            ],
            "aliases": {
                "AtikPdf": "Atik\\Pdf\\Facades\\AtikPdf"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
