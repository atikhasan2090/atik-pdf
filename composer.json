{
    "name": "atik/laravel-pdf-excel",
    "description": "Enterprise-grade hybrid Laravel package for PDF, Excel & CSV generation with ultra-fast large-table support and full Bangla font rendering.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Atik",
            "email": "atik@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^8.0|^10.0|^11.0|^12.0",
        "mpdf/mpdf": "^8.2",
        "spatie/browsershot": "^4.0|^5.0",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Atik\\PdfExcel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atik\\PdfExcel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atik\\PdfExcel\\PdfExcelServiceProvider"
            ],
            "aliases": {
                "PdfExcel": "Atik\\PdfExcel\\Facades\\PdfExcel"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
